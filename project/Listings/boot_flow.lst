N/* 赛题协议固定字段 */
N#define BOOT_PROTO_START        0xA5B6U
N#define BOOT_PROTO_END          0xB6A5U
N#define BOOT_PROTO_VERSION      0x02U
N#define BOOT_PROTO_BROADCAST_ID 0xFFFFU
N
N/* 帧类型 */

Nstatic void boot_flow_send_query_id(uint16_t command)
N{
N    uint8_t content[2];
N
N    content[0] = (uint8_t)(g_boot_param.device_id >> 8);
N    content[1] = (uint8_t)g_boot_param.device_id;
N    boot_proto_send_frame(g_boot_param.device_id, BOOT_PROTO_FRAME_RESP,
X    boot_proto_send_frame(g_boot_param.device_id, 0x02U,
N                          command, content, sizeof(content));
N}
N
Nstatic void boot_flow_send_query_baud(uint16_t command)
N{
N    uint8_t content = g_boot_param.baud_code;
N
N    boot_proto_send_frame(g_boot_param.device_id, BOOT_PROTO_FRAME_RESP,
X    boot_proto_send_frame(g_boot_param.device_id, 0x02U,
N                          command, &content, 1U);
N}
N
Nstatic boot_flow_event_t boot_flow_process_frame_once(uint32_t timeout_ms)
N{
N    boot_proto_frame_t frame;
N    boot_proto_frame_status_t status;
N
N    status = boot_proto_wait_frame(timeout_ms, g_boot_param.device_id, &frame);
N
N    if (status == BOOT_PROTO_FRAME_NONE) {
N        return BOOT_FLOW_EVENT_NONE;
N    }
N    if (status == BOOT_PROTO_FRAME_ID_MISMATCH) {
N        return BOOT_FLOW_EVENT_KEEP_WAITING;
N    }
N
N    if (status == BOOT_PROTO_FRAME_BAD) {
N        if (g_suppress_next_bad_frame) {
N            g_suppress_next_bad_frame = false;
X            g_suppress_next_bad_frame = 0;
N            return BOOT_FLOW_EVENT_KEEP_WAITING;
N        }
N
N        boot_proto_send_error(g_boot_param.device_id, BOOT_PROTO_CMD_ERROR);
X        boot_proto_send_error(g_boot_param.device_id, 0xEEEEU);
N        return BOOT_FLOW_EVENT_KEEP_WAITING;
N    }
N
N    g_suppress_next_bad_frame = false;
X    g_suppress_next_bad_frame = 0;
N
N    if ((frame.frame_type == BOOT_PROTO_FRAME_HEART) &&
X    if ((frame.frame_type == 0x05U) &&
N        (frame.command == BOOT_PROTO_CMD_BROADCAST)) {
X        (frame.command == 0xFFFFU)) {
N        boot_proto_send_heartbeat(g_boot_param.device_id);
N        return BOOT_FLOW_EVENT_KEEP_WAITING;
N    }
N
N    if (frame.frame_type != BOOT_PROTO_FRAME_CMD) {
X    if (frame.frame_type != 0x01U) {
N        boot_proto_send_error(g_boot_param.device_id, BOOT_PROTO_CMD_ERROR);
X        boot_proto_send_error(g_boot_param.device_id, 0xEEEEU);
N        return BOOT_FLOW_EVENT_KEEP_WAITING;
N    }
N
N    switch (frame.command) {
N    case BOOT_PROTO_CMD_QUERY_ID:
X    case 0x0111U:
N        boot_flow_send_query_id(frame.command);
N        break;
N
N    case BOOT_PROTO_CMD_QUERY_BAUD:
X    case 0x0112U:
N        boot_flow_send_query_baud(frame.command);
N        break;
N
N    case BOOT_PROTO_CMD_UPGRADE_READY: {
X    case 0x0502U: {
N        boot_status_t ret;
N
N        if (frame.content_len != 0U) {
N            boot_proto_send_error(g_boot_param.device_id, frame.command);
N            break;
N        }
N
N        boot_flow_show_oled();
N        ret = boot_upgrade_receive_stage_image(&g_upgrade_ctx);
N        if (ret == BOOT_STATUS_OK) {
N            boot_proto_send_ok(g_boot_param.device_id, frame.command);
N            g_suppress_next_bad_frame = true;
X            g_suppress_next_bad_frame = 1;
N            return BOOT_FLOW_EVENT_IMAGE_STAGED;
N        }
N
N        boot_proto_send_error(g_boot_param.device_id, frame.command);
N        (void)boot_upgrade_prepare_stage(&g_upgrade_ctx);
N        g_suppress_next_bad_frame = true;
X        g_suppress_next_bad_frame = 1;
N        break;
N    }
N
N    case BOOT_PROTO_CMD_UPGRADE_EXEC: {
X    case 0x0503U: {
N        boot_status_t ret;
N
N        if (frame.content_len != 0U) {
N            boot_proto_send_error(g_boot_param.device_id, frame.command);
N            break;
N        }
N
N        if (!g_upgrade_ctx.pending_valid) {
N            boot_proto_send_error(g_boot_param.device_id, frame.command);
N            break;
N        }
N
N        //升级前先把OK发完，Flash搬运会卡一段时间
N        boot_proto_send_ok(g_boot_param.device_id, frame.command);
N
N        boot_flow_show_oled();
N        ret = boot_upgrade_execute(&g_upgrade_ctx, &g_boot_param);
N        if (ret == BOOT_STATUS_OK) {
N            boot_app_jump_raw(BOOT_APP_ADDR);
X            boot_app_jump_raw(0x08011000U);
N        }
N
N        boot_flow_show_oled();
N        break;
N    }
N
N    default:
N        boot_proto_send_error(g_boot_param.device_id, BOOT_PROTO_CMD_ERROR);
X        boot_proto_send_error(g_boot_param.device_id, 0xEEEEU);
N        break;
N    }
N
N    return BOOT_FLOW_EVENT_KEEP_WAITING;
N}
N
Nstatic void boot_flow_print_wait_prompt(uint32_t remaining_sec, uint32_t *last_printed)
N{
N    if (((remaining_sec == 10U) ||
N         (remaining_sec == 7U) ||
N         (remaining_sec == 4U) ||
N         (remaining_sec == 1U)) &&
N        (*last_printed != remaining_sec)) {
N        rs485_printf("wait for start Application(%lus)......\r\n", (unsigned long)remaining_sec);
N        *last_printed = remaining_sec;
N    }
N}
N
Nvoid boot_flow_init(void)
N{
N    (void)boot_param_load(&g_boot_param);
N    boot_upgrade_init(&g_upgrade_ctx);
N    boot_proto_rx_enable();
N}
N
Nbool boot_flow_update_requested(void)
X_Bool boot_flow_update_requested(void)
N{
N    return g_boot_param.boot_flag == BOOT_FLAG_UPDATE;
X    return g_boot_param.boot_flag == 0xA5U;
N}
N
Nbool boot_flow_boot_default(void)
X_Bool boot_flow_boot_default(void)
N{
N    if (boot_app_can_boot()) {
N        boot_app_jump_raw(BOOT_APP_ADDR);
X        boot_app_jump_raw(0x08011000U);
N        return true;
X        return 1;
N    }
N
N    if (boot_upgrade_restore_backup_to_app()) {
N        boot_app_jump_raw(BOOT_APP_ADDR);
X        boot_app_jump_raw(0x08011000U);
N        return true;
X        return 1;
N    }
N
N    return false;
X    return 0;
N}
N
Nvoid boot_flow_console(void)
N{
N    uint32_t start;
N    uint32_t last_printed = 0xFFFFFFFFU;
N    bool countdown_active = true;
X    _Bool countdown_active = 1;
N
N    g_suppress_next_bad_frame = false;
X    g_suppress_next_bad_frame = 0;
N    g_upgrade_ctx.pending_valid = false;
X    g_upgrade_ctx.pending_valid = 0;
N
N    boot_flow_show_oled();
N
N    (void)boot_upgrade_prepare_stage(&g_upgrade_ctx);
N
N    boot_flow_show_oled();
N
N    rs485_printf("using command to interrupt start Application\r\n");
N
N    start = GetTick();
N    while (1) {
N        boot_flow_event_t event;
N
N        if (countdown_active) {
N            uint32_t elapsed = GetTick() - start;
N            uint32_t remaining = (elapsed >= BOOT_WAIT_APP_MS) ? 0U : (10U - (elapsed / 1000U));
X            uint32_t remaining = (elapsed >= 10000U) ? 0U : (10U - (elapsed / 1000U));
N
N            boot_flow_print_wait_prompt(remaining, &last_printed);
N            event = boot_flow_process_frame_once(BOOT_FRAME_POLL_MS);
X            event = boot_flow_process_frame_once(100U);
N
N            if (event == BOOT_FLOW_EVENT_IMAGE_STAGED) {
N                countdown_active = false;
X                countdown_active = 0;
N            }
N
N            if (elapsed >= BOOT_WAIT_APP_MS) {
X            if (elapsed >= 10000U) {
N                if (g_boot_param.boot_flag == BOOT_FLAG_UPDATE) {
X                if (g_boot_param.boot_flag == 0xA5U) {
N                    (void)boot_param_set_boot_flag(&g_boot_param, BOOT_FLAG_NORMAL);
X                    (void)boot_param_set_boot_flag(&g_boot_param, 0x00U);
N                }
N
N                if (boot_flow_boot_default()) {
N                    while (1) {
N                    }
N                }
N
N                countdown_active = false;
X                countdown_active = 0;
N            }
N        } else {
N            (void)boot_flow_process_frame_once(1000U);
N        }
N    }
N}

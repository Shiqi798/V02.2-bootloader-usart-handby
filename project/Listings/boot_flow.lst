N
N/* Bootloader 当前关心的命令 */
N#define BOOT_PROTO_CMD_QUERY_ID   0x0111U
N#define BOOT_PROTO_CMD_QUERY_BAUD 0x0112U
N#define BOOT_PROTO_CMD_UPGRADE_READY 0x0502U
N#define BOOT_PROTO_CMD_UPGRADE_EXEC  0x0503U
N#define BOOT_PROTO_CMD_HEARTBEAT     0x8888U
N#define BOOT_PROTO_CMD_BROADCAST     0xFFFFU
N#define BOOT_PROTO_CMD_ERROR         0xEEEEU
N
N#define BOOT_PROTO_CONTENT_MAX 16U
N
Ntypedef struct {
N    uint16_t device_id;
N    uint8_t frame_type;
N    uint16_t command;
N    uint8_t content_len;
N    uint8_t content[BOOT_PROTO_CONTENT_MAX];
X    uint8_t content[16U];
